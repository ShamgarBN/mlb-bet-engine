*.ipynb_checkpoints

# --- Testing / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# --- This project: data is NEVER committed ---
# Anchored with leading slash so it only matches the top-level data/ directory.
# Without the slash this rule was silently swallowing src/mlb_model/data/ too.
/data/
!/data/.gitkeep
/kaggle-data/
*.parquet
*.duckdb
*.duckdb.wal
*.csv
!data_dictionary*.csv

# --- Models ---
# Ignore the dir *contents* (not the dir itself) so the exceptions below
# can un-ignore specific files -- git can't un-ignore under an ignored dir.
models/*
*.pkl
*.joblib
# Hitter-prop calibrators are derived from the 5-season backtest and
# committed because they're tiny (<1 KB each) and required for the
# Matchups page to render probabilities on a fresh clone.
!models/hitter_calibrator_*.joblib
!models/.gitkeep
*.lgb
*.xgb

# --- Logs ---
# Ignore the *contents* (not the dir itself) so the exceptions below can
# un-ignore specific files — git can't un-ignore a file under an ignored dir.
logs/*
*.log
# ...but DO track the curated walk-forward backtest CSVs — they're the
# source of truth for the /performance page and get bundled into the .app.
!logs/backtest_v4.csv
!logs/backtest_2026.csv
# Hitter-prop 5-season backtest parquet -- ships in the bundle and
# seeds the /season By-tier cards. Small (1.4 MB) and stable.
!logs/hitter_backtest_2021_2025_v2.parquet

# --- End-of-season reports (generated annually) ---
reports/
!reports/.gitkeep

# --- Secrets ---
secrets.toml
*.pem
*.key

# --- macOS .app bundle (rebuilt by scripts/build_app_bundle.sh on each Mac) ---
MLB Forecast.app/

# --- Transfer tarballs (generated by scripts/package_for_transfer.sh) ---
mlb-model-transfer-*.tar.gz

# --- PyInstaller build output ---
/build/
/dist/
# Distributable DMG lives at the project root for easy access; never commit it.
*.dmg
